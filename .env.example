# Copy to .env and fill in. Read-only Atlassian access (Confluence + Jira).
TAPESTRY_CONFLUENCE_BASE_URL=https://yoursite.atlassian.net/wiki
TAPESTRY_CONFLUENCE_SPACES=TPE,TPS
TAPESTRY_JIRA_BASE_URL=https://yoursite.atlassian.net
TAPESTRY_JIRA_PROJECT=MFS5T

# Atlassian auth (Basic: email + API token)
# token: https://id.atlassian.com/manage-profile/security/api-tokens
TAPESTRY_EMAIL=you@company.com
TAPESTRY_API_TOKEN=

# Optional (defaults shown)
# TAPESTRY_DATA_DIR=./data
# OPENAI_BASE_URL=http://localhost:11434/v1
# TAPESTRY_EMBED_MODEL=nomic-embed-text
